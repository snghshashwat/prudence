NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used by lib/supabase/admin.ts
# and scripts/seed-demo-users.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the Google OAuth redirect URL when the request has no
# Origin header. Set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enables one-click demo logins that BYPASS AUTHENTICATION, for local
# testing or sending a review link before Supabase is connected. Safe only
# on a deployment with NO real Supabase project: it auto-disables the
# moment NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are both
# set, flag or no flag. Never rely on that as your only safeguard, unset
# this the moment you connect a real backend.
NEXT_PUBLIC_ENABLE_DEMO=false
