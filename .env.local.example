NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used by lib/supabase/admin.ts
# and scripts/seed-demo-users.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Used to build the Google OAuth redirect URL when the request has no
# Origin header. Set to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enables one-click demo logins that BYPASS AUTHENTICATION for local
# frontend testing. Leave unset in production (also force-disabled there).
NEXT_PUBLIC_ENABLE_DEMO=false
